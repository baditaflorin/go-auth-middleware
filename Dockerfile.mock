# Multi-stage build for mock auth service
FROM golang:1.20-alpine AS builder

RUN apk add --no-cache git make

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -installsuffix cgo -ldflags="-w -s" -o /app/mock-auth ./examples/mock-auth-service

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

WORKDIR /app

COPY --from=builder /app/mock-auth .

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8081

CMD ["./mock-auth"]
