# Go Auth Middleware Configuration
# Copy this file to .env and customize for your environment
# Never commit .env files to version control!

# Required: Authentication Service URL
AUTH_SERVICE_URL=http://localhost:8081

# Optional: Authentication Endpoint Configuration
AUTH_VALIDATE_ENDPOINT=/validate
AUTH_TOKEN_HEADER=Authorization
AUTH_TOKEN_PREFIX="Bearer "
AUTH_USER_ID_KEY=user_id

# Optional: HTTP Client Configuration
AUTH_TIMEOUT=10s
AUTH_MAX_RETRIES=3
AUTH_RETRY_WAIT_MIN=100ms
AUTH_RETRY_WAIT_MAX=2s

# Optional: Circuit Breaker Configuration
AUTH_CB_MAX_REQUESTS=3
AUTH_CB_INTERVAL=60s
AUTH_CB_TIMEOUT=30s
AUTH_CB_THRESHOLD=5

# Optional: Rate Limiting
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_RPS=100

# Optional: Security Settings
AUTH_MAX_TOKEN_LENGTH=8192
AUTH_VALIDATE_URL=true

# Optional: Logging Configuration
AUTH_LOG_LEVEL=info
AUTH_LOG_FORMAT=json

# Optional: GUI Configuration (for test harness)
GUI_PORT=3000

# Optional: Application Port (for examples)
PORT=8080

# Optional: Gin Mode (debug, release, test)
GIN_MODE=debug
